# Machine state, not project state.
.env
run.log
*.log

# The painted floor mask and the camera pose belong to ONE room and ONE camera
# position. Committing them is worse than leaving them out: whoever clones this
# would silently inherit another room's geometry, and the failure looks like a
# code bug rather than a missing calibration. Both are regenerated by
# `make calibrate`.
config/floor_mask.png
config/camera_calibration.json

__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
reference/
