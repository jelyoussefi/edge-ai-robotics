{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose ps:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-edit.sh\"",
            "timeout": 30,
            "statusMessage": "Checking edited file..."
          }
        ]
      }
    ]
  }
}
