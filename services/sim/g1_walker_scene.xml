<mujoco model="g1_walker_flat">
  <!--
    Clean walking scene for the G1 walker policy. Includes the fetched g1.xml
    (29-DoF, matching the policy) and nothing else but a floor and a light.
    The tables and props from the original challenge scene are intentionally
    dropped: this milestone is locomotion, not manipulation.
  -->
  <include file="g1.xml"/>

  <statistic center="0 0 0.9" extent="1.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <!-- No haze and no gradient skybox: the compositor renders the robot over a
         BLACK background so the GPU shader can tell robot pixels (non-black) from
         empty background and show the real camera there. -->
    <rgba haze="0 0 0 1"/>
    <global azimuth="135" elevation="-20"/>
  </visual>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" condim="3" group="2"/>
  </worldbody>
</mujoco>
