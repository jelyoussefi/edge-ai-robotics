# Robot model: g1, h1 or t1
ROBOT=g1

# Controller: kinematic (always stable, no weights) or rl (trained policy)
POLICY=kinematic

# Display the viewer draws on
DISPLAY=:0

# Cores reserved for the physics loop, e.g. 8-11. Empty lets the scheduler decide.
SIM_CPUS=

# OpenVINO device for the RL policy: NPU, GPU or CPU
OV_DEVICE=NPU
